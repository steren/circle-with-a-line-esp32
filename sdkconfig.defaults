CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB octal PSRAM inside the ESP32-S3R8 (holds the framebuffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Log over the built-in USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Room for generating a puzzle on the spot in the game loop
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Speed for generating puzzles: full CPU clock, optimised code
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The puzzle generator keeps the second core busy at low priority for seconds
# at a time; that is intended, so don't treat it as a hang
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
